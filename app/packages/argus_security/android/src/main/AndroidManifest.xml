<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="app.argus.argus_security">
    <!-- Android 13+: asked once, when the student opens the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application>
        <service android:name=".ArgusMessagingService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="argus_notices"/>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_argus"/>
    </application>
</manifest>
