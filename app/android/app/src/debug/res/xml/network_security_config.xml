<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP to a developer's machine, e.g. the
     emulator host (10.0.2.2), localhost via `adb reverse`, or the dev Mac's
     LAN address for test phones on the same Wi-Fi (build with the
     dart-define ARGUS_API=http://LAN-IP:8080).
     Release builds keep Android's default: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
