{
  "name": "backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts serve",
    "migrate": "node --env-file-if-exists=.env src/main.ts migrate",
