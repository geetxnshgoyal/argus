    "fastify": "^5.12.5",
    "ipaddr.js": "^2.5.0",
    "jose": "^6.2.12",
    "kysely": "^0.29.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "pg-boss": "^12.33.6",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
