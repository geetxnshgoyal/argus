# systemd unit for Linux servers.
# Install:  sudo cp argus.service /etc/systemd/system/ && sudo systemctl enable --now argus
# Logs:     journalctl -u argus -f
[Unit]
Description=Argus attendance server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=argus
WorkingDirectory=/opt/argus
ExecStart=/usr/bin/node --env-file=/opt/argus/argus.env /opt/argus/server.mjs serve
Restart=always
RestartSec=5
# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/argus

[Install]
WantedBy=multi-user.target
