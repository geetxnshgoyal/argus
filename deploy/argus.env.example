# Argus server settings. Copy to argus.env next to server.mjs and fill in.
# Lines starting with # are comments.

# Which environment this is: production | staging
ARGUS_ENV=production

# Postgres connection (Postgres 16 or newer).
DATABASE_URL=postgres://argus:CHANGE_ME@localhost:5432/argus

# Where the server listens. Put the college's HTTPS proxy/load balancer in front.
ARGUS_HOST=0.0.0.0
ARGUS_PORT=8080

# Set to true only if a reverse proxy sits in front and sets X-Forwarded-For.
ARGUS_TRUST_PROXY=true

# 32 random bytes, base64. Generate once with:  openssl rand -base64 32
# Keep it secret and back it up separately from the database backups:
# without it, encrypted session secrets cannot be read.
ARGUS_MASTER_KEY=

# Public address people use to reach Argus (https in production).
ARGUS_PUBLIC_URL=https://argus.example.edu

# College Google sign-in. Create an OAuth client (type: Web application) in the
# college's Google Cloud project with redirect URI:
#   https://argus.example.edu/v1/auth/oidc/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_HOSTED_DOMAIN=svyasa-sas.edu.in

# info is right for normal operation; use debug only when investigating a problem.
ARGUS_LOG_LEVEL=info

# NEVER set these outside development; the server refuses to start if you do.
# ARGUS_ATTESTATION_BYPASS=false
# ARGUS_DEV_LOGIN=false
